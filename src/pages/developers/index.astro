---
import Base from "../../layouts/Base.astro";
import WaysIn from "../../components/WaysIn.astro";
import CodeTabs from "../../components/CodeTabs.astro";
import { Code } from "astro:components";
import { allDocs, slugOf } from "../../lib/docs";

const KIT = "https://github.com/macedonga/visor-kit";
const doc = (slug: string) => `/developers/docs/${slug}/`;
const themes = { light: "github-light", dark: "github-dark-dimmed" } as const;

const card = `
visor.display.cards.set("pasta", "Kitchen timer", LayoutIconName.CLOCK) {
    header(LayoutIconName.CLOCK, "Kitchen timer")
    stat("4:00", "Pasta")
    progress(0.6)
    detail {
        field("Started", "19:42")
        field("Ends", "19:52")
        buttons { button("stop", "Stop") { toast = "Stopped" } }
    }
}`;

const tabs = [
  {
    label: "Kotlin",
    lang: "kotlin",
    code: `
val visor = Visor.connect(context)

val ask = registerForActivityResult(RequestScopes()) { held -> /* the scopes the app holds now */ }
ask.launch(setOf(Scope.CAMERA, Scope.BAND))

visor.band.gestures.collect { gesture ->
    if (gesture.derived == GestureAction.DOUBLE_TAP) visor.camera.takePhoto()
}`,
    note: `<code>com.macedonga.visor:kit</code>. <a href="${doc("getting-started")}">Getting started</a>`,
  },
  {
    label: "Python",
    lang: "python",
    code: `
async with await visor_kit.connect_adb() as visor:
    print(await visor.call("glasses.status"))
    async for gesture in visor.subscribe("band.gestures"):
        print(gesture["finger"], gesture["derived"])`,
    note: `<code>pip install visor-kit</code>. <a href="${doc("network")}">The network door</a>`,
  },
  {
    label: "TypeScript",
    lang: "ts",
    code: `
const visor = await Visor.connect("ws://192.168.1.20:7333/rpc", token);
visor.subscribe("band.gestures", {}, (gesture) => console.log(gesture));`,
    note: `<code>npm install visor-kit</code>. <a href="${doc("json-rpc")}">JSON-RPC</a>`,
  },
  {
    label: "Web app",
    lang: "ts",
    code: `
import { Visor, onGlasses } from "visor-kit";

if (onGlasses()) {
  const visor = await Visor.connectGlasses();
  await visor.call("voice.speak", { text: "Hello from the web app" });
}`,
    note: `Runs in the Display's browser. <a href="${doc("web-apps")}">Web apps on the Display</a>`,
  },
];

const areas = [
  ["Glasses", "glasses.*", "glasses", "Status, every pair, motion, touches and presses."],
  ["Camera", "camera.*", "camera-and-captures", "Photos into the gallery, videos, the live camera, imports."],
  ["Display", "display.*", "display", "Layouts and their clicks, Briefing cards, the teleprompter."],
  ["Neural Band", "band.*", "neural-band", "Gestures, wrist motion and vibration."],
  ["Voice", "voice.*", "voice-and-assistant", "Questions that name your app, spoken answers, transcripts."],
  ["Assistant", "assistant.*", "voice-and-assistant", "Your app's tools for the wearer's model."],
  ["Settings", "settings.*", "settings", "Every setting the glasses keep."],
  ["Web apps", "connectGlasses()", "web-apps", "All of it from JavaScript on the Display."],
];

// What `visor fake` prints, as it prints it.
const fakeRun = `
$ visor fake
FakeVisor on ws://127.0.0.1:7333/rpc and http://127.0.0.1:7333/mcp; visor --fake on port 7334. Type help.
The Display simulator: http://127.0.0.1:7333/display`;

const tools = [
  ["visor simulate band.gestures", "Gestures without a band: type them, and your app gets them."],
  ["visor trace", "Every call and event between your app and Visor, live."],
  ["FakeVisor", "Visor inside your app's unit tests, with the same Display."],
];

// The setup prompt is the AI page's first one, so the two never drift apart.
const aiPage = (await allDocs()).find((d) => slugOf(d) === "ai-tools")!;
// The fence is written as \x60 (a backtick): Astro's compiler misreads backticks inside a regex here.
const setupPrompt = /\x60{3}text\r?\n([\s\S]*?)\x60{3}/.exec(aiPage.body ?? "")![1].trim();
const ai = doc("ai-tools");
const agentKit = [
  ["Every page, for agents", "llms.txt, llms-full.txt, and any page as .md", `${ai}#what-agents-can-read`],
  ["The docs over MCP", "visor docs-mcp", `${ai}#the-docs-as-an-mcp-server`],
  ["Rules for agents", "visor agents > AGENTS.md", `${ai}#rules-for-agents`],
  ["The Claude Code plugin", "/plugin install vdk@visor-kit", `${ai}#the-claude-code-plugin`],
  ["Fake glasses for agents", "visor fake, MCP on port 7333", `${ai}#the-glasses-for-agents`],
];

const installs = [
  ["Android", 'implementation("com.macedonga.visor:kit:0.1.0")'],
  ["Android tests", 'testImplementation("com.macedonga.visor:kit-testing:0.1.0")'],
  ["Python", "pip install visor-kit"],
  ["TypeScript", "npm install visor-kit"],
  ["visor on macOS and Linux", "curl -fsSL https://visor.macedonga.com/install.sh | sh"],
  ["visor on Windows", "irm https://visor.macedonga.com/install.ps1 | iex"],
];

const wrap = "mx-auto max-w-6xl px-4 sm:px-6";
const h2 = "text-2xl font-semibold tracking-tight md:text-3xl";
const button = "inline-flex h-10 items-center rounded px-4 text-[15px] font-medium transition-transform duration-100 active:scale-97";
---
<Base
  title="Visor for developers: build apps for Meta glasses"
  description="The Visor Development Kit lets Android apps, scripts, AI agents and Display web apps use Meta glasses through Visor, with the wearer's consent. No Meta account, no Meta AI app, no developer review."
  world="blueprint"
  section="developers"
>
  <section class="grid-paper border-b border-line">
    <div class:list={[wrap, "pt-16 pb-14 md:pt-24 md:pb-20"]}>
      <h1 class="max-w-3xl text-5xl leading-none font-semibold tracking-[-0.04em] text-balance md:text-7xl">Build apps for Meta glasses.</h1>
      <p class="mt-6 max-w-xl text-lg text-muted">Android, Python, TypeScript and web apps on the Display, with the wearer's consent.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class:list={[button, "bg-accent text-accent-ink hover:bg-accent/90"]} href={doc("getting-started")}>Get started</a>
        <a class:list={[button, "border border-line bg-bg hover:border-faint"]} href="/developers/docs/">Docs</a>
      </div>
      <!-- These lines, and the card they put on the Display, drawn by the VDK's simulator. -->
      <figure class="m-0 mt-14 grid items-center gap-6 md:mt-20 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
        <div class="on-panel overflow-hidden rounded-md bg-panel shadow-xl ring-1 ring-white/10">
          <div class="border-b border-white/10 px-4 py-2.5 font-mono text-xs text-white/50">KitchenTimer.kt</div>
          <Code code={card.trim()} lang="kotlin" themes={themes} defaultColor={false} class="!p-5" />
        </div>
        <img src="/shots/briefing.webp" width="640" height="640" alt="The card on the Display's Briefing: Kitchen timer, 4:00, Pasta, and a progress bar."
          class="aspect-square w-full rounded-[5.625%] shadow-xl max-lg:max-w-md" />
      </figure>
    </div>
  </section>

  <section class:list={[wrap, "py-20 md:py-28"]} aria-labelledby="ways-title">
    <h2 id="ways-title" class:list={[h2, "mb-10"]}>Four ways in</h2>
    <WaysIn />
  </section>

  <section class:list={[wrap, "pb-20 md:pb-28"]} aria-labelledby="lang-title">
    <h2 id="lang-title" class:list={[h2, "mb-8"]}>In your language</h2>
    <CodeTabs label="Code samples" tabs={tabs} />
  </section>

  <section class:list={[wrap, "pb-20 md:pb-28"]} aria-labelledby="ai-title">
    <h2 id="ai-title" class:list={[h2, "mb-8"]}>AI-assisted development</h2>
    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
      <div data-copy-scope class="on-panel overflow-hidden rounded-md bg-panel ring-1 ring-white/10">
        <div class="flex items-center justify-between border-b border-white/10 py-1.5 pr-2 pl-4 font-mono text-xs text-white/50">
          Paste into your agent
          <button type="button" data-copy class="rounded-sm border border-white/15 px-2 py-0.5 font-sans text-white/70 hover:text-white">Copy</button>
        </div>
        <pre data-line class="m-0 p-5 font-mono text-[13px] leading-relaxed whitespace-pre-wrap text-white/85">{setupPrompt}</pre>
      </div>
      <ul class="m-0 list-none border-t border-line p-0">
        {agentKit.map(([name, how, href]) => (
          <li class="border-b border-line">
            <a href={href} class="group grid gap-0.5 py-3">
              <span class="font-medium group-hover:text-accent">{name}</span>
              <code class="text-[13px] text-muted">{how}</code>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class:list={[wrap, "pb-20 md:pb-28"]} aria-labelledby="areas-title">
    <h2 id="areas-title" class:list={[h2, "mb-6"]}>What your code can use</h2>
    <ul class="m-0 list-none border-t border-line p-0">
      {areas.map(([name, ns, slug, line]) => (
        <li class="border-b border-line">
          <a href={doc(slug)} class="group grid gap-x-8 gap-y-1 py-4 sm:grid-cols-[10rem_1fr_auto] sm:items-baseline">
            <strong class="font-semibold group-hover:text-accent">{name}</strong>
            <span class="text-muted">{line}</span>
            <code class="text-[13px] text-faint">{ns}</code>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class:list={[wrap, "pb-20 md:pb-28"]} aria-labelledby="testing-title">
    <h2 id="testing-title" class:list={[h2, "mb-10"]}>Test without the glasses</h2>
    <!-- One command, and the simulator it serves: the real output and the real page. -->
    <div class="relative">
      <figure class="m-0 overflow-hidden rounded-md bg-[#17181c] shadow-xl ring-1 ring-white/10 lg:ml-[24%]">
        <div class="border-b border-white/10 px-4 py-2.5 font-mono text-xs text-white/50">127.0.0.1:7333/display</div>
        <img src="/shots/simulator.webp" width="1600" height="1317" loading="lazy" class="block h-auto w-full"
          alt="The Display simulator from visor fake: the Briefing with the two cards, and controls for the touchpad, the band and the view." />
      </figure>
      <div class="on-panel mt-4 overflow-hidden rounded-md bg-panel shadow-2xl ring-1 ring-white/10 lg:absolute lg:bottom-10 lg:left-0 lg:mt-0 lg:w-[44%]">
        <div class="border-b border-white/10 px-4 py-2.5 font-mono text-xs text-white/50">Terminal</div>
        <Code code={fakeRun.trim()} lang="console" themes={themes} defaultColor={false} class="!p-5" />
      </div>
    </div>
    <dl class="m-0 mt-12 grid gap-8 border-t border-line pt-8 sm:grid-cols-3">
      {tools.map(([name, what]) => (
        <div>
          <dt><code class="text-sm font-medium text-ink">{name}</code></dt>
          <dd class="m-0 mt-1.5 text-muted">{what}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class:list={[wrap, "pb-20 md:pb-28"]} aria-labelledby="install-title">
    <h2 id="install-title" class:list={[h2, "mb-8"]}>Install</h2>
    <ul class="m-0 list-none divide-y divide-line rounded-md border border-line p-0">
      {installs.map(([where, line]) => (
        <li class="grid items-center gap-x-6 gap-y-1 px-4 py-3 sm:grid-cols-[12rem_minmax(0,1fr)_auto]">
          <span class="text-sm text-muted">{where}</span>
          <code class="text-sm break-all text-ink" data-line>{line}</code>
          <button type="button" data-copy class="justify-self-start rounded-sm border border-line px-2 py-0.5 text-xs text-muted hover:text-ink sm:justify-self-end">Copy</button>
        </li>
      ))}
    </ul>
    <p class="mt-3 text-sm text-muted">The visor command needs Java 17 or later, which Android Studio brings.</p>
  </section>

  <section class="grid-paper border-t border-line">
    <div class:list={[wrap, "flex flex-wrap items-center justify-between gap-6 py-14"]}>
      <h2 class={h2}>How the glasses work, down to the bytes.</h2>
      <div class="flex flex-wrap gap-3">
        <a class:list={[button, "bg-accent text-accent-ink hover:bg-accent/90"]} href="/protocol/">The protocol</a>
        <a class:list={[button, "border border-line bg-bg hover:border-faint"]} href={KIT}>The VDK on GitHub</a>
      </div>
    </div>
  </section>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      // The line to copy sits in the same row, or in the same panel as the button.
      const line = button.closest("li, [data-copy-scope]")?.querySelector("[data-line]")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(line);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Copy failed";
      }
      setTimeout(() => (button.textContent = "Copy"), 1600);
    });
  }
</script>
