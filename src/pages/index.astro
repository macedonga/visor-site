---
import Base from "../layouts/Base.astro";
import VMark from "../components/VMark.astro";

const RELEASES = "https://github.com/macedonga/visor/releases/latest";
const REPO = "https://github.com/macedonga/visor";

const features = [
  ["Home", "Your pair in 3D, both batteries, storage and the latest photos."],
  ["Gallery", "Photos and videos import over Wi-Fi while the glasses charge."],
  ["Live view", "The camera on your phone. Record, replay, broadcast."],
  ["Assistant", "\"Hey Meta\" answers with Claude or any OpenAI-compatible model."],
  ["Notifications", "Messages on the glasses, with the names from your contacts."],
  ["Settings", "Every setting the glasses have, the advanced ones too."],
  ["Meta Ray-Ban Display", "Captions, translation, a teleprompter and your apps' cards."],
  ["Neural Band", "Gestures and vibration, shared with the apps on your phone."],
  ["More than one pair", "Every pair on one phone. Swipe between them."],
];

const hosts = [
  ["Meta", "accounts.meta.com, api.accounts.meta.com, meta.graph.meta.com, ar.graph.meta.com, graph.facebook-hardware.com", "During setup: the login, and the receipt that makes Visor the owner app of your glasses."],
  ["Meta", "ar-genai.graph.meta.com", "Your pair's frame and lens colour, assistant language packs, and the Display's weather, sports and stocks."],
  ["Meta", "ar.graph.meta.com, graph.facebook.com, i.instagram.com", "When you link a Facebook, Instagram or Threads account: its tokens, for the glasses."],
  ["Your model provider", "", "Your question, with your own API key, when you ask the assistant."],
  ["Your RTMP server", "", "The broadcast, when you go live from the Live view."],
  ["OpenStreetMap", "nominatim.openstreetmap.org, routing.openstreetmap.de", "Searches and routes for Maps on the Display."],
  ["GitHub", "api.github.com", "Twice a day, to check for a new release. You can turn it off."],
];

// The rule above each section spans the text, not the gutters.
const section = "mx-auto w-[calc(100%-2rem)] border-t border-line py-16 sm:w-[min(69rem,calc(100%-3rem))] md:py-28";
const h2 = "text-3xl font-semibold tracking-tight md:text-4xl";
const pill = "inline-flex h-11 items-center rounded-full px-5 text-[15px] font-medium transition-transform duration-100 active:scale-97";
---
<Base
  title="Visor: Meta glasses without the Meta AI app"
  description="An open Android app for Ray-Ban Meta, Oakley Meta and the Meta Ray-Ban Display. Your photos stay on your phone, and 'Hey Meta' answers with the model you choose."
  world="night"
>
  <section class="relative overflow-hidden px-4 pt-24 pb-28 text-center md:pt-40 md:pb-44">
    <!-- One beam from above, as on Visor's banner. -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(42%_60%_at_50%_0%,rgb(255_241_226/0.13),rgb(255_210_161/0.04)_55%,transparent_80%)]"></div>
    <div class="relative mx-auto flex max-w-4xl flex-col items-center">
      <VMark variant="lit" class="w-20 drop-shadow-[0_0_40px_rgb(255_210_161/0.25)] md:w-28" />
      <h1 class="mt-10 text-5xl leading-none font-semibold tracking-[-0.045em] text-balance md:text-7xl lg:text-8xl">
        Meta glasses, without the Meta&nbsp;AI&nbsp;app.
      </h1>
      <div class="mt-11 flex flex-wrap justify-center gap-3">
        <a class:list={[pill, "bg-white text-black hover:bg-white/85"]} href={RELEASES}>Download for Android</a>
        <a class:list={[pill, "border border-line hover:border-white/40"]} href={REPO}>View on GitHub</a>
      </div>
    </div>
  </section>

  <section id="features" class={section} aria-labelledby="features-title">
    <h2 id="features-title" class={h2}>What it does</h2>
    <dl class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {features.map(([name, line]) => (
        <div>
          <dt class="text-[17px] font-semibold tracking-tight">{name}</dt>
          <dd class="mt-1.5 max-w-xs text-muted">{line}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="privacy" class={section} aria-labelledby="privacy-title">
    <h2 id="privacy-title" class="max-w-3xl text-4xl leading-[1.02] font-semibold tracking-[-0.045em] text-balance md:text-6xl lg:text-7xl">
      No server. No analytics. No&nbsp;crash&nbsp;reports.
    </h2>
    <details class="group mt-10">
      <summary class="w-fit cursor-pointer font-medium text-muted hover:text-ink">Every place Visor connects to</summary>
      <table class="mt-5 w-full text-[15px]">
        <tbody>
          {hosts.map(([to, names, what]) => (
            <tr class="border-t border-line max-sm:block max-sm:py-3">
              <th scope="row" class="w-5/12 py-3.5 pr-6 text-left align-top font-medium max-sm:block max-sm:w-auto max-sm:py-0">
                {to}{names && <code class="mt-1 block text-xs font-normal break-words text-faint">{names}</code>}
              </th>
              <td class="py-3.5 align-top text-muted max-sm:block max-sm:pt-1.5 max-sm:pb-0">{what}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </details>
  </section>

  <section id="install" class={section} aria-labelledby="install-title">
    <h2 id="install-title" class={h2}>Install</h2>
    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {[
        <>Download the APK from the <a class="text-ink underline decoration-white/30 hover:decoration-white" href={RELEASES}>latest release</a>.</>,
        <>Check its SHA-256 against the <code class="text-ink">.sha256</code> file beside it.</>,
        <>Install it. Android asks to allow installs from your browser.</>,
        <>Open Visor and follow the setup.</>,
      ].map((step, i) => (
        <li class="text-muted"><span class="mb-3 block text-2xl font-semibold tracking-tight text-ink">{i + 1}</span>{step}</li>
      ))}
    </ol>
    <p class="mt-12 max-w-2xl text-muted">
      Needs Android 12 or later, a Meta account for setup, and an API key for the assistant. The glasses take one
      session at a time, so Visor and the Meta AI app replace each other.
    </p>
    <details class="mt-5">
      <summary class="w-fit cursor-pointer font-medium text-muted hover:text-ink">Release signing certificate</summary>
      <pre class="mt-3 rounded-xl bg-surface p-4 font-mono text-xs leading-relaxed whitespace-pre-wrap break-all">CN=Visor
SHA-256: F6:01:C7:FE:63:EF:04:E0:7F:66:8A:EC:BA:5A:2B:9C:
         23:90:C4:C0:22:B5:2B:5F:B0:F6:D3:04:22:7C:B9:C7</pre>
    </details>
  </section>

  <!-- A window onto the developers' drawing board, white whatever the system's scheme. -->
  <section class="mx-auto w-[calc(100%-2rem)] pb-16 sm:w-[min(69rem,calc(100%-3rem))] md:pb-28" aria-labelledby="dev-title">
    <a href="/developers/" data-world="paper"
      class="grid-paper group grid items-center gap-10 overflow-hidden rounded-[28px] bg-bg p-8 text-ink md:grid-cols-[1fr_auto] md:p-14">
      <div>
        <h2 id="dev-title" class="text-3xl font-semibold tracking-tight md:text-5xl">Build for the glasses</h2>
        <p class="mt-4 max-w-md text-lg text-muted">Your apps, scripts and AI agents, on the camera, the Display and the band.</p>
        <span class="mt-7 inline-block font-medium text-accent underline decoration-accent/40 group-hover:decoration-accent">Visor for developers</span>
      </div>
      <img src="/shots/briefing.webp" width="640" height="640" loading="lazy"
        class="w-full max-w-xs rounded-[5.625%] shadow-2xl md:w-80"
        alt="The Display's Briefing with two cards from an app: a kitchen timer at 4:00 and a morning run of 5.2 km." />
    </a>
  </section>
</Base>
