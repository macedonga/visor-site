---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found | Visor" description="This page does not exist." world="night">
  <section class="mx-auto max-w-6xl px-4 py-32 sm:px-6 md:py-48">
    <h1 class="text-5xl font-semibold tracking-[-0.04em] md:text-6xl">This page is out of reach.</h1>
    <div class="mt-10 flex flex-wrap gap-3">
      <a class="inline-flex h-11 items-center rounded-full bg-white px-5 font-medium text-black active:scale-97" href="/">Visor</a>
      <a class="inline-flex h-11 items-center rounded-full border border-line px-5 font-medium active:scale-97" href="/developers/docs/">Docs</a>
    </div>
  </section>
</Base>
